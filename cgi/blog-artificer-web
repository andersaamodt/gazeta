#!/bin/sh
# Owner-gated Artificer Web reverse proxy.

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
. "$SCRIPT_DIR/blog-lib.sh"
. "$SCRIPT_DIR/blog-desk-common.sh"

blog_init
blog_read_request_body

artificer_web_trim() {
  printf '%s' "${1-}" | tr -d '\r\n' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

artificer_web_error() {
  message=$1
  code=$2
  blog_send_json_headers
  blog_json_error "$message" "$code"
}

artificer_web_send_json_headers() {
  http-status 200 "OK"
  http-header "Content-Type" "application/json; charset=utf-8"
  http-header "Cache-Control" "no-store, no-cache, must-revalidate, max-age=0"
  http-header "Pragma" "no-cache"
  http-header "Expires" "0"
  if [ -n "${BLOG_ARTIFICER_WEB_COOKIE_VALUE-}" ]; then
    cookie="artificer_web_session=$BLOG_ARTIFICER_WEB_COOKIE_VALUE; Path=/cgi/blog-artificer-web; HttpOnly; SameSite=Strict"
    case "${HTTPS-}${REQUEST_SCHEME-}${SERVER_PORT-}" in
      *on*|*ON*|*https*|*HTTPS*|*443*) cookie="$cookie; Secure" ;;
    esac
    http-header "Set-Cookie" "$cookie"
  fi
  blog_send_security_headers
  http-end-headers
}

artificer_web_config_value() {
  key=$1
  env_key=$2
  eval "env_value=\${$env_key-}"
  if [ -n "$env_value" ]; then
    printf '%s\n' "$env_value"
    return 0
  fi
  config-get "$blog_site_conf" "$key" 2>/dev/null || printf ''
}

artificer_web_remote_base() {
  raw=$(artificer_web_config_value artificer_remote_base BLOG_ARTIFICER_REMOTE_BASE)
  raw=$(artificer_web_trim "$raw")
  case "$raw" in
    http://*|https://*) ;;
    *) printf '\n'; return 0 ;;
  esac
  case "$raw" in
    *[!A-Za-z0-9:/?._~=%@+,-]*|*[[:space:]]*|*'#'*)
      printf '\n'
      return 0
      ;;
  esac
  printf '%s\n' "$raw" | sed 's#/*$##'
}

artificer_web_remote_token() {
  raw=$(artificer_web_config_value artificer_remote_token BLOG_ARTIFICER_REMOTE_TOKEN)
  if [ -z "$raw" ]; then
    token_file=$(artificer_web_config_value artificer_remote_token_file BLOG_ARTIFICER_REMOTE_TOKEN_FILE)
    token_file=$(artificer_web_trim "$token_file")
    if [ -z "$token_file" ]; then
      token_file="$blog_site_data/artificer/remote-token"
    fi
    case "$token_file" in
      /*) [ -f "$token_file" ] && raw=$(sed -n '1p' "$token_file" 2>/dev/null || printf '') ;;
    esac
  fi
  raw=$(artificer_web_trim "$raw")
  case "$raw" in
    *[!A-Za-z0-9._~=-]*|'') printf '\n' ;;
    *) printf '%s\n' "$raw" ;;
  esac
}

artificer_web_allowed_nostr_pubkeys() {
  raw=$(artificer_web_config_value artificer_web_allowed_nostr_pubkeys BLOG_ARTIFICER_WEB_ALLOWED_NOSTR_PUBKEYS)
  if [ -z "$raw" ]; then
    raw=$(artificer_web_config_value artificer_web_allowed_nostr_pubkey BLOG_ARTIFICER_WEB_ALLOWED_NOSTR_PUBKEY)
  fi
  printf '%s\n' "$raw" | tr ',[:space:]' '\n' | while IFS= read -r candidate; do
    candidate=$(blog_validate_nostr_pubkey "$candidate" 2>/dev/null || printf '')
    [ -n "$candidate" ] && printf '%s\n' "$candidate"
  done
}

artificer_web_transport() {
  base=$1
  case "$base" in
    *.onion|*.onion/*|http://*.onion|https://*.onion|http://*.onion:*|https://*.onion:*) printf 'tor\n' ;;
    *) printf 'direct\n' ;;
  esac
}

artificer_web_forward_query() {
  printf '%s' "${QUERY_STRING-}" | awk '
    BEGIN { RS = "&"; first = 1 }
    $0 == "" { next }
    $0 ~ /^(path|session_token|csrf_token)=/ { next }
    {
      if (!first) printf "&"
      printf "%s", $0
      first = 0
    }
  '
}

artificer_web_safe_path() {
  candidate=$1
  case "$candidate" in
    '') printf '/\n'; return 0 ;;
    /*) ;;
    *) return 1 ;;
  esac
  case "$candidate" in
    *'\'*|*'//'*) return 1 ;;
  esac
  case "$candidate" in
    */../*|*/..|/..|*%0a*|*%0A*|*%0d*|*%0D*) return 1 ;;
  esac
  printf '%s\n' "$candidate"
}

artificer_web_content_type() {
  path=$1
  case "$path" in
    *.js) printf 'application/javascript; charset=utf-8\n' ;;
    *.css) printf 'text/css; charset=utf-8\n' ;;
    *.svg) printf 'image/svg+xml\n' ;;
    *.png) printf 'image/png\n' ;;
    *.jpg|*.jpeg) printf 'image/jpeg\n' ;;
    *.webp) printf 'image/webp\n' ;;
    *.woff2) printf 'font/woff2\n' ;;
    *.json) printf 'application/json; charset=utf-8\n' ;;
    *) printf 'text/html; charset=utf-8\n' ;;
  esac
}

artificer_web_cacheable_asset() {
  path=$1
  case "$path" in
    /static/*.js|/static/*.css|/static/*.svg|/static/*.png|/static/*.jpg|/static/*.jpeg|/static/*.webp|/static/*.woff2)
      return 0
      ;;
  esac
  return 1
}

artificer_web_send_headers() {
  content_type=$1
  path=${2:-}
  http-status 200 "OK"
  http-header "Content-Type" "$content_type"
  if artificer_web_cacheable_asset "$path"; then
    http-header "Cache-Control" "private, max-age=604800, stale-while-revalidate=86400"
    http-header "Vary" "Accept-Encoding"
  else
    http-header "Cache-Control" "no-store, no-cache, must-revalidate, max-age=0"
    http-header "Pragma" "no-cache"
    http-header "Expires" "0"
  fi
  blog_send_security_headers
  http-end-headers
}

artificer_web_rewrite_text() {
  path=$1
  case "$path" in
    *.js)
      sed \
        -e 's#"/cgi/artificer-api#"/cgi/blog-artificer-web?path=/cgi/artificer-api#g' \
        -e "s#'/cgi/artificer-api#'/cgi/blog-artificer-web?path=/cgi/artificer-api#g" \
        -e 's#"/static/#"/cgi/blog-artificer-web?path=/static/#g' \
        -e "s#'/static/#'/cgi/blog-artificer-web?path=/static/#g"
      ;;
    *.css)
      sed -e 's#url(/static/#url(/cgi/blog-artificer-web?path=/static/#g'
      ;;
    *)
      sed \
        -e 's#?v=" + encodeURIComponent(versionTag) + "\&launch=" + encodeURIComponent(launchKey)#?v=" + encodeURIComponent(versionTag)#g' \
        -e 's#fetch(moduleUrl, { cache: "no-store" })#fetch(moduleUrl, { cache: "default" })#g' \
        -e 's#href="/#href="/cgi/blog-artificer-web?path=/#g' \
        -e 's#src="/#src="/cgi/blog-artificer-web?path=/#g' \
        -e 's#action="/#action="/cgi/blog-artificer-web?path=/#g'
      ;;
  esac
}

artificer_web_cookie_value() {
  printf '%s' "${HTTP_COOKIE-}" | tr ';' '\n' | sed -n 's/^[[:space:]]*artificer_web_session=//p' | tail -n 1
}

artificer_web_curl() {
  base=$1
  token=$2
  target=$3
  method=${REQUEST_METHOD:-GET}
  timeout=${BLOG_ARTIFICER_REMOTE_TIMEOUT:-45}
  transport=$(artificer_web_transport "$base")

  if [ "$method" = "POST" ] || [ "$method" = "PUT" ] || [ "$method" = "PATCH" ]; then
    if [ "$transport" = "tor" ]; then
      socks=${BLOG_ARTIFICER_TOR_SOCKS:-127.0.0.1:9050}
      printf '%s' "$BLOG_REQUEST_BODY" | curl --silent --show-error --fail --location --compressed --max-time "$timeout" --socks5-hostname "$socks" \
        -X "$method" -H "X-Artificer-Remote-Token: $token" -H "Content-Type: ${CONTENT_TYPE:-application/json}" --data-binary @- "$target"
    else
      printf '%s' "$BLOG_REQUEST_BODY" | curl --silent --show-error --fail --location --compressed --max-time "$timeout" \
        -X "$method" -H "X-Artificer-Remote-Token: $token" -H "Content-Type: ${CONTENT_TYPE:-application/json}" --data-binary @- "$target"
    fi
  else
    if [ "$transport" = "tor" ]; then
      socks=${BLOG_ARTIFICER_TOR_SOCKS:-127.0.0.1:9050}
      curl --silent --show-error --fail --location --compressed --max-time "$timeout" --socks5-hostname "$socks" \
        -H "X-Artificer-Remote-Token: $token" "$target"
    else
      curl --silent --show-error --fail --location --compressed --max-time "$timeout" \
        -H "X-Artificer-Remote-Token: $token" "$target"
    fi
  fi
}

artificer_web_session_is_allowed_nostr_key() {
  session_pubkey=$(blog_validate_nostr_pubkey "${BLOG_SESSION_USER_PUBKEY-}" 2>/dev/null || printf '')
  [ -n "$session_pubkey" ] || return 1
  case "${BLOG_SESSION_AUTH_METHOD-}" in
    nostr|nostr_*) ;;
    *) return 1 ;;
  esac
  allowed_pubkeys=$(artificer_web_allowed_nostr_pubkeys)
  if [ -n "$allowed_pubkeys" ]; then
    printf '%s\n' "$allowed_pubkeys" | grep -Fqx "$session_pubkey"
    return $?
  fi
  return 1
}

artificer_web_require_allowed_nostr_key() {
  ARTIFICER_WEB_AUTH_ERROR=''
  req_token=$(blog_param "session_token")
  req_csrf=$(blog_param "csrf_token")
  if [ -z "$req_token" ] || [ -z "$req_csrf" ]; then
    cookie_pair=$(artificer_web_cookie_value)
    case "$cookie_pair" in
      *:*)
        req_token=${cookie_pair%%:*}
        req_csrf=${cookie_pair#*:}
        ;;
    esac
  fi
  case "$req_token$req_csrf" in
    *[!A-Za-z0-9._~=-]*|'') ;;
    *) BLOG_ARTIFICER_WEB_COOKIE_VALUE="$req_token:$req_csrf"; export BLOG_ARTIFICER_WEB_COOKIE_VALUE ;;
  esac

  if ! blog_load_session "$req_token"; then
    ARTIFICER_WEB_AUTH_ERROR=$(blog_json_error "Sign in with the authorized Nostr identity to open Artificer Web." "auth_required")
    return 1
  fi
  if [ -z "$req_csrf" ] || [ "$req_csrf" != "$BLOG_SESSION_CSRF" ]; then
    ARTIFICER_WEB_AUTH_ERROR=$(blog_json_error "Invalid CSRF token" "csrf_invalid")
    return 1
  fi
  if ! artificer_web_session_is_allowed_nostr_key; then
    ARTIFICER_WEB_AUTH_ERROR=$(blog_json_error "Sign in with the authorized Nostr identity to open Artificer Web." "nostr_key_required")
    return 1
  fi
  blog_extend_session
  return 0
}

if ! artificer_web_require_allowed_nostr_key; then
  artificer_web_send_json_headers
  printf '%s\n' "$ARTIFICER_WEB_AUTH_ERROR"
  exit 0
fi

action=$(blog_param action)
path=$(blog_param path)
base=$(artificer_web_remote_base)
token=$(artificer_web_remote_token)

case "$action" in
  status)
    if [ -z "$path" ]; then
      artificer_web_send_json_headers
      if [ -n "$base" ] && [ -n "$token" ]; then
        transport=$(artificer_web_transport "$base")
        printf '{"success":true,"configured":true,"transport":"%s"}\n' "$transport"
      else
        printf '{"success":true,"configured":false}\n'
      fi
      exit 0
    fi
    ;;
esac

if [ -z "$base" ]; then
  artificer_web_error "Artificer remote base is not configured." "remote_base_missing"
  exit 0
fi
if [ -z "$token" ]; then
  artificer_web_error "Artificer remote token is not configured." "remote_token_missing"
  exit 0
fi

if ! safe_path=$(artificer_web_safe_path "$path"); then
  artificer_web_error "Invalid Artificer proxy path." "invalid_path"
  exit 0
fi

query=$(artificer_web_forward_query)
target="$base$safe_path"
if [ -n "$query" ]; then
  target="$target?$query"
fi

content_type=$(artificer_web_content_type "$safe_path")
artificer_web_send_headers "$content_type" "$safe_path"
case "$content_type" in
  text/html*|application/javascript*|text/css*)
    if ! artificer_web_curl "$base" "$token" "$target" | artificer_web_rewrite_text "$safe_path"; then
      :
    fi
    ;;
  *)
    if ! artificer_web_curl "$base" "$token" "$target"; then
      :
    fi
    ;;
esac
