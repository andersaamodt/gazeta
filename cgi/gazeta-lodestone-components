#!/bin/sh
# Render Gazeta-owned Lodestone custom elements.

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
. "$SCRIPT_DIR/blog-post-cards-common.sh"

payload=$(cat)
name=$(printf '%s\n' "$payload" | jq -r '.name // ""' 2>/dev/null || printf '')

render_blog_post_list() {
  posts_json=$(
    printf '%s\n' "$payload" | jq -r '
      def html_unescape:
        gsub("&quot;"; "\"")
        | gsub("&#39;"; "\u0027")
        | gsub("&gt;"; ">")
        | gsub("&lt;"; "<")
        | gsub("&amp;"; "&");

      ((.attrs.posts // "[]") | tostring | html_unescape)
    ' 2>/dev/null || printf '[]'
  )
  active_tag=''
  payload_file=${BLOG_NOSTR_PRERENDER_PAYLOAD_FILE-}
  if [ -n "$payload_file" ] && [ -f "$payload_file" ]; then
    active_tag=$(jq -r '.state.default_tag // ""' "$payload_file" 2>/dev/null || printf '')
  fi
  blog_post_cards_render_list_html "$posts_json" "$active_tag"
}

render_nostr_page_content() {
  page_type=$(
    printf '%s\n' "$payload" | jq -r '
      ((.attrs.page_type // .frontmatter.page_type // "") | tostring)
    ' 2>/dev/null || printf ''
  )
  fallback_body=$(
    printf '%s\n' "$payload" | jq -r '
      (.body // "") | tostring
    ' 2>/dev/null || printf ''
  )
  payload_file=${BLOG_NOSTR_PRERENDER_PAYLOAD_FILE-}
  if [ -z "$page_type" ] || [ -z "$payload_file" ] || [ ! -f "$payload_file" ]; then
    printf '%s' "$fallback_body"
    return 0
  fi
  . "$SCRIPT_DIR/blog-lib.sh"
  . "$SCRIPT_DIR/blog-list-common.sh"
  . "$SCRIPT_DIR/blog-public-ranking-common.sh"
  . "$SCRIPT_DIR/gazeta-nostr-page-content-renderer.sh"
  rendered_html=$(blog_nostr_page_prerender_content_html "$(cat "$payload_file")" "$page_type" 2>/dev/null || printf '')
  if [ -n "$rendered_html" ]; then
    printf '%s' "$rendered_html"
    return 0
  fi
  printf '%s' "$fallback_body"
}

case "$name" in
  gazeta-blog-post-list)
    render_blog_post_list
    ;;
  gazeta-nostr-page-content)
    render_nostr_page_content
    ;;
  *)
    exit 3
    ;;
esac
