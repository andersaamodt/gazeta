#!/bin/sh
# Get Nostr-backed page state, preferring the current local site state for public readers.

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
if [ -z "${WIZARDRY_SITES_DIR:-}" ] || [ -z "${WIZARDRY_SITE_NAME:-}" ]; then
  script_site_root=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd -P)
  : "${WIZARDRY_SITES_DIR:=$(dirname "$script_site_root")}"
  : "${WIZARDRY_SITE_NAME:=$(basename "$script_site_root")}"
  export WIZARDRY_SITES_DIR WIZARDRY_SITE_NAME
fi
. "$SCRIPT_DIR/blog-lib.sh"
. "$SCRIPT_DIR/blog-list-common.sh"
. "$SCRIPT_DIR/blog-public-ranking-common.sh"
. "$SCRIPT_DIR/blog-nostr-pages-common.sh"

blog_init
blog_read_request_body
blog_send_json_headers

page_slug=$(blog_nostr_page_slug "$(blog_param page_slug)")
if [ -z "$page_slug" ]; then
  page_slug=$(blog_nostr_page_slug "$(blog_param list_slug)")
fi
if [ -z "$page_slug" ]; then
  page_slug="list"
fi

page_type=$(blog_nostr_page_type_for_slug "$page_slug" 2>/dev/null || printf '')
if [ -z "$page_type" ]; then
  local_mount_candidate=$(blog_nostr_page_mount_path "$page_slug" 2>/dev/null || printf '')
  if [ -n "$local_mount_candidate" ] && [ -f "$local_mount_candidate" ]; then
    local_mount_type=$(blog_nostr_page_source_template_type "$local_mount_candidate" 2>/dev/null || printf 'custom')
    case "$local_mount_type" in
      contact|public-ranking|overworld|list|icon-gallery|blog|nip23)
        page_type=$local_mount_type
        ;;
      *)
        page_type=nip23
        ;;
    esac
  else
    blog_json_error "Unknown Nostr page slug" "unknown_page"
    exit 0
  fi
fi
if ! blog_plugin_enabled "nostr_posts"; then
  blog_json_error "Nostr-backed pages plugin is disabled for this site" "plugin_disabled"
  exit 0
fi
kind=$(blog_nostr_page_kind_for_type "$page_type")
nav_title=$(blog_nostr_page_placeholder_title "$page_slug" 2>/dev/null || printf '')
if [ -z "$nav_title" ]; then
  nav_title=$(blog_nostr_page_default_title "$page_slug" "$page_type")
fi

is_admin=false
req_token=$(blog_param session_token)
req_csrf=$(blog_param csrf_token)
if [ -n "$req_token" ] && blog_load_session "$req_token" 2>/dev/null; then
  if [ -n "$req_csrf" ] && [ "$req_csrf" = "$BLOG_SESSION_CSRF" ] && blog_user_is_admin "$BLOG_SESSION_USERNAME"; then
    is_admin=true
    BLOG_SESSION_IS_ADMIN=true
  fi
fi
viewer_pubkey=''
if [ -n "$req_token" ] && blog_load_session "$req_token" 2>/dev/null; then
  viewer_pubkey=$(blog_validate_nostr_pubkey "${BLOG_SESSION_USER_PUBKEY-}" 2>/dev/null || printf '')
fi

draft_state_json=''
if draft_candidate=$(blog_nostr_page_load_draft_state_json "$page_slug" "$page_type" 2>/dev/null || printf ''); then
  draft_state_json=$draft_candidate
fi

draft_exists=false
if [ -n "$draft_state_json" ]; then
  draft_exists=true
fi

local_state_json=''
local_has_source=false

local_source_path=$(blog_nostr_page_draft_path "$page_slug" 2>/dev/null || printf '')
if [ -n "$local_source_path" ] && [ -f "$local_source_path" ]; then
  local_state_json=$draft_state_json
  if [ -z "$local_state_json" ]; then
    local_raw=$(blog_state_markdown_to_json "$local_source_path" content 2>/dev/null || printf '')
    case "$page_type" in
      contact)
        local_state_json=$(blog_contact_normalize_state_json "$page_slug" "$local_raw")
        ;;
      public-ranking)
        local_state_json=$(blog_public_ranking_normalize_state_json "$page_slug" "$local_raw")
        ;;
      nip23|blog)
        local_state_json=$(blog_nip23_normalize_state_json "$page_slug" "$local_raw" "$page_type")
        ;;
      *)
        local_state_json=$(blog_list_normalize_state_json "$page_slug" "$local_raw")
        ;;
    esac
  fi
  if [ -n "$local_state_json" ]; then
    local_has_source=true
  fi
fi

if [ "$local_has_source" != "true" ]; then
  local_source_path=$(blog_nostr_page_source_path "$page_slug" "$page_type")
  if [ -n "$local_source_path" ] && [ ! -f "$local_source_path" ]; then
    local_mount_source_path=$(blog_nostr_page_mount_path "$page_slug" 2>/dev/null || printf '')
    if [ -n "$local_mount_source_path" ] && [ -f "$local_mount_source_path" ]; then
      local_source_path=$local_mount_source_path
    fi
  fi
  if [ -n "$local_source_path" ] && [ -f "$local_source_path" ]; then
    if ! blog_nostr_page_source_template_is_managed "$local_source_path"; then
      local_has_source=true
      local_raw=$(blog_state_markdown_to_json "$local_source_path" content 2>/dev/null || printf '')
      case "$page_type" in
        contact)
          local_state_json=$(blog_contact_normalize_state_json "$page_slug" "$local_raw")
          ;;
        public-ranking)
          local_state_json=$(blog_public_ranking_normalize_state_json "$page_slug" "$local_raw")
          ;;
        nip23|blog)
          local_state_json=$(blog_nip23_normalize_state_json "$page_slug" "$local_raw" "$page_type")
          ;;
        *)
          local_state_json=$(blog_list_normalize_state_json "$page_slug" "$local_raw")
          ;;
      esac
    fi
  fi
fi
if [ -z "$local_state_json" ]; then
  case "$page_type" in
    contact)
      local_state_json=$(blog_contact_default_state_json "$page_slug")
      ;;
    public-ranking)
      local_state_json=$(blog_public_ranking_default_state_json "$page_slug")
      ;;
    nip23|blog)
      local_state_json=$(blog_nip23_default_state_json "$page_slug" "$page_type")
      ;;
    *)
      local_state_json=$(blog_list_default_state_json "$page_slug")
      ;;
  esac
fi

canonical_mtime=0
if [ "$local_has_source" = "true" ]; then
  canonical_mtime=$(stat -c %Y "$local_source_path" 2>/dev/null || stat -f %m "$local_source_path" 2>/dev/null || printf '0')
fi
case "$canonical_mtime" in
  ''|*[!0-9]*) canonical_mtime=0 ;;
esac

canonical_event_json=''
canonical_state_json=''
canonical_exists=false
case "$page_type" in
  contact)
    canonical_event_json=$(blog_nostr_contact_latest_event_json 2>/dev/null || printf '')
    if [ -n "$canonical_event_json" ]; then
      canonical_exists=true
      canonical_state_json=$(blog_contact_state_from_event_json "$page_slug" "$canonical_event_json")
    else
      canonical_state_json=$local_state_json
    fi
    ;;
  public-ranking)
    canonical_event_json=$(blog_nostr_public_ranking_latest_event_json "$page_slug" 2>/dev/null || printf '')
    if [ -n "$canonical_event_json" ]; then
      canonical_exists=true
      canonical_state_json=$(blog_public_ranking_state_from_event_json "$page_slug" "$canonical_event_json")
    else
      canonical_state_json=$local_state_json
    fi
    ;;
  nip23|blog)
    canonical_event_json=$(blog_nostr_nip23_latest_event_json "$page_slug" 2>/dev/null || printf '')
    if [ -n "$canonical_event_json" ]; then
      canonical_exists=true
      canonical_state_json=$(blog_nip23_state_from_event_json "$page_slug" "$canonical_event_json" "$page_type")
    else
      canonical_state_json=$local_state_json
    fi
    ;;
  *)
    canonical_event_json=$(blog_nostr_list_latest_event_json "$page_slug" 2>/dev/null || printf '')
    if [ -n "$canonical_event_json" ]; then
      canonical_exists=true
      canonical_state_json=$(blog_list_state_from_event_json "$page_slug" "$canonical_event_json")
    else
      canonical_state_json=$local_state_json
    fi
    ;;
esac
if [ -z "$canonical_state_json" ]; then
  canonical_state_json=$local_state_json
fi
canonical_created_at=$(printf '%s\n' "$canonical_event_json" | jq -r '.created_at // 0' 2>/dev/null || printf '0')
case "$canonical_created_at" in
  ''|*[!0-9]*) canonical_created_at=0 ;;
esac

case "$page_type" in
  nip23|blog)
    canonical_state_json=$(blog_nip23_normalize_state_json "$page_slug" "$canonical_state_json" "$page_type")
    ;;
  *)
    : # other page types are already normalized by source parsing
    ;;
esac

# Treat an empty legacy Home/index page as non-existent.
if [ "$page_slug" = "index" ] && [ "$page_type" = "nip23" ] && [ "$canonical_exists" != "true" ] && [ "$draft_exists" != "true" ] && [ "$local_has_source" != "true" ]; then
  blog_json_error "Unknown Nostr page slug" "unknown_page"
  exit 0
fi

draft_local_json='{}'
if [ -n "$draft_state_json" ]; then
  draft_local_json=$(printf '%s\n' "$draft_state_json" | jq -c '{
    extras_after: (.extras_after // ""),
    extras_after_format: "markdown"
  }' 2>/dev/null || printf '{}')
fi

view_mode="canonical"
view_state_json=$canonical_state_json

if [ "$is_admin" = "true" ]; then
  view_mode="draft"
  if [ -n "$draft_state_json" ]; then
    view_state_json=$draft_state_json
  else
    view_state_json=$canonical_state_json
  fi
elif [ "$local_has_source" = "true" ]; then
  view_mode="local"
  view_state_json=$local_state_json
else
  if [ "$canonical_exists" != "true" ] && [ -n "$draft_state_json" ]; then
    view_mode="draft_readonly"
    view_state_json=$draft_state_json
  else
    view_mode="canonical"
    view_state_json=$canonical_state_json
  fi
fi

canonical_sig_state_json=$canonical_state_json
canonical_state_json=$(printf '%s\n' "$canonical_state_json" | jq -c --argjson local "$draft_local_json" '. + {extras_after: ($local.extras_after // .extras_after), extras_after_format: ($local.extras_after_format // .extras_after_format)}' 2>/dev/null || printf '%s\n' "$canonical_state_json")
view_state_json=$(printf '%s\n' "$view_state_json" | jq -c --argjson local "$draft_local_json" '. + {extras_after: ($local.extras_after // .extras_after), extras_after_format: ($local.extras_after_format // .extras_after_format)}' 2>/dev/null || printf '%s\n' "$view_state_json")
if [ "$page_type" = "blog" ]; then
  page_entry_json=$(blog_nostr_page_entry_json "$page_slug" 2>/dev/null || printf '')
  default_tag=''
  if [ -n "$page_entry_json" ]; then
    default_tag=$(printf '%s\n' "$page_entry_json" | jq -r '.default_tag // ""' 2>/dev/null || printf '')
  fi
  canonical_state_json=$(printf '%s\n' "$canonical_state_json" | jq -c --arg default_tag "$default_tag" '. + {default_tag: $default_tag}' 2>/dev/null || printf '%s\n' "$canonical_state_json")
  view_state_json=$(printf '%s\n' "$view_state_json" | jq -c --arg default_tag "$default_tag" '. + {default_tag: $default_tag}' 2>/dev/null || printf '%s\n' "$view_state_json")
fi
if [ "$page_type" = "nip23" ] || [ "$page_type" = "blog" ]; then
  canonical_state_json=$(printf '%s\n' "$canonical_state_json" | jq -c 'del(.description, .publish_intro_to_nostr)' 2>/dev/null || printf '%s\n' "$canonical_state_json")
  view_state_json=$(printf '%s\n' "$view_state_json" | jq -c 'del(.description, .publish_intro_to_nostr)' 2>/dev/null || printf '%s\n' "$view_state_json")
fi

sync_status='unknown'
if [ "$local_has_source" = "true" ] && [ "$canonical_exists" = "true" ]; then
  if [ "$canonical_mtime" -gt "$canonical_created_at" ]; then
    sync_status='local_newer_than_nostr'
  elif [ "$canonical_created_at" -gt "$canonical_mtime" ]; then
    sync_status='nostr_newer_than_local'
  else
    sync_status='in_sync'
  fi
elif [ "$local_has_source" = "true" ]; then
  sync_status='unpublished_local_changes'
elif [ "$canonical_exists" = "true" ]; then
  sync_status='nostr_newer_than_local'
fi

sync_status_message="Server copy and published Nostr state are in sync."
if [ "$sync_status" = "local_newer_than_nostr" ]; then
  sync_status_message='Server copy is newer than the latest published Nostr state. Visitors see the server copy.'
elif [ "$sync_status" = "nostr_newer_than_local" ]; then
  sync_status_message='Published Nostr state is newer than the server copy. Visitors still see the server copy until the site source changes.'
elif [ "$sync_status" = "unpublished_local_changes" ]; then
  sync_status_message='This page exists only on the server so far. Visitors see the server copy.'
elif [ "$sync_status" = "unknown" ]; then
  sync_status_message='Cannot determine local-vs-Nostr sync status yet.'
fi

sync_status_json=$(jq -cn \
  --arg status "$sync_status" \
  --arg message "$sync_status_message" \
  --argjson local_mtime "$( [ -n "$canonical_mtime" ] && printf '%s\n' "$canonical_mtime" || printf 0 )" \
  --argjson nostr_created_at "$( [ -n "$canonical_created_at" ] && printf '%s\n' "$canonical_created_at" || printf 0 )" \
  --argjson has_canonical_event "$( [ "$canonical_exists" = "true" ] && printf true || printf false )" \
  --argjson local_has_source "$( [ "$local_has_source" = "true" ] && printf true || printf false )" \
  '{status:$status,message:$message,local_mtime:$local_mtime,nostr_created_at:$nostr_created_at,has_canonical_event:$has_canonical_event,local_has_source:$local_has_source}'
)

draft_differs=false
if [ "$draft_exists" = "true" ]; then
  case "$page_type" in
    contact)
      draft_sig=$(blog_contact_state_signature_json "$draft_state_json")
      canonical_sig=$(blog_contact_state_signature_json "$canonical_sig_state_json")
      ;;
    public-ranking)
      draft_sig=$(blog_public_ranking_state_signature_json "$draft_state_json")
      canonical_sig=$(blog_public_ranking_state_signature_json "$canonical_sig_state_json")
      ;;
    nip23|blog)
      draft_sig=$(blog_nip23_state_signature_json "$draft_state_json")
      canonical_sig=$(blog_nip23_state_signature_json "$canonical_sig_state_json")
      ;;
    *)
      draft_sig=$(blog_list_state_signature_json "$draft_state_json")
      canonical_sig=$(blog_list_state_signature_json "$canonical_sig_state_json")
      ;;
  esac
  if [ "$draft_sig" != "$canonical_sig" ]; then
    draft_differs=true
  fi
fi

case "$page_type" in
  contact)
    validation_json=$(blog_contact_validate_and_enrich_state_json "$view_state_json" false)
    view_state_json=$(printf '%s\n' "$view_state_json" | jq -c --argjson validation "$validation_json" '. + {rows: $validation.rows, content_json: $validation.content_json}')
    ;;
  public-ranking)
    validation_json=$(blog_public_ranking_validate_and_enrich_state_json "$view_state_json" false)
    include_pending=false
    if [ "$is_admin" = "true" ]; then
      include_pending=true
    fi
    selected_metric=$(printf '%s' "$(blog_param sort_metric)" | tr '[:upper:]' '[:lower:]')
    ranking_enriched=$(blog_public_ranking_view_json "$page_slug" "$view_state_json" "$canonical_event_json" "$include_pending" "$selected_metric" "$viewer_pubkey")
    view_state_json=$(printf '%s\n' "$view_state_json" | jq -c --argjson ranking "$ranking_enriched" '. + $ranking')
    canonical_state_json=$(printf '%s\n' "$canonical_state_json" | jq -c --argjson ranking "$(blog_public_ranking_view_json "$page_slug" "$canonical_state_json" "$canonical_event_json" false "$selected_metric" "$viewer_pubkey")" '. + $ranking')
    ;;
  nip23|blog)
    validation_json=$(blog_nip23_validate_and_enrich_state_json "$view_state_json" false)
    ;;
  *)
    viewer_username=''
    if [ -n "$req_token" ] && blog_load_session "$req_token" 2>/dev/null; then
      viewer_username=${BLOG_SESSION_USER_PUBKEY:-${BLOG_SESSION_USERNAME-}}
    fi
    validation_json=$(jq -cn --argjson state "$view_state_json" '{
      elements: ($state.elements // []),
      entries: ($state.entries // []),
      errors: [],
      warnings: [],
      can_publish: true
    }')
    validation_json=$(blog_list_merge_public_activity_json "$view_state_json" "$validation_json" "$viewer_username")
    validation_tmp=$(mktemp "${TMPDIR:-/tmp}/blog-list-validation.XXXXXX")
    printf '%s\n' "$validation_json" > "$validation_tmp"
    view_state_json=$(printf '%s\n' "$view_state_json" | jq -c --slurpfile validation "$validation_tmp" '. + {elements: ($validation[0].elements // []), entries: ($validation[0].entries // [])}')
    rm -f "$validation_tmp"
    canonical_validation_json=$(jq -cn --argjson state "$canonical_state_json" '{
      elements: ($state.elements // []),
      entries: ($state.entries // []),
      errors: [],
      warnings: [],
      can_publish: true
    }')
    canonical_validation_json=$(blog_list_merge_public_activity_json "$canonical_state_json" "$canonical_validation_json" "")
    canonical_validation_tmp=$(mktemp "${TMPDIR:-/tmp}/blog-list-validation.XXXXXX")
    printf '%s\n' "$canonical_validation_json" > "$canonical_validation_tmp"
    canonical_state_json=$(printf '%s\n' "$canonical_state_json" | jq -c --slurpfile validation "$canonical_validation_tmp" '. + {elements: ($validation[0].elements // []), entries: ($validation[0].entries // [])}')
    rm -f "$canonical_validation_tmp"
    ;;
esac

state_tmp=$(mktemp "${TMPDIR:-/tmp}/blog-nostr-page-state.XXXXXX")
canonical_state_tmp=$(mktemp "${TMPDIR:-/tmp}/blog-nostr-page-state.XXXXXX")
canonical_event_tmp=$(mktemp "${TMPDIR:-/tmp}/blog-nostr-page-event.XXXXXX")
sync_status_tmp=$(mktemp "${TMPDIR:-/tmp}/blog-nostr-page-sync-status.XXXXXX")
zap_config_tmp=$(mktemp "${TMPDIR:-/tmp}/blog-nostr-page-zap.XXXXXX")
validation_tmp=$(mktemp "${TMPDIR:-/tmp}/blog-nostr-page-validation.XXXXXX")
response_tmp=$(mktemp "${TMPDIR:-/tmp}/blog-nostr-page-response.XXXXXX")
printf '%s\n' "$view_state_json" > "$state_tmp"
printf '%s\n' "$canonical_state_json" > "$canonical_state_tmp"
if [ -n "$canonical_event_json" ]; then
  printf '%s\n' "$canonical_event_json" > "$canonical_event_tmp"
else
  printf 'null\n' > "$canonical_event_tmp"
fi
printf '%s\n' "$sync_status_json" > "$sync_status_tmp"
blog_zaps_config_json > "$zap_config_tmp"
printf '%s\n' "$validation_json" > "$validation_tmp"

jq -cn \
  --arg slug "$page_slug" \
  --arg page_type "$page_type" \
  --arg nav_title "$nav_title" \
  --argjson kind "$kind" \
  --argjson is_admin "$( [ "$is_admin" = "true" ] && printf true || printf false )" \
  --arg view_mode "$view_mode" \
  --argjson canonical_exists "$( [ "$canonical_exists" = "true" ] && printf true || printf false )" \
  --argjson draft_exists "$( [ "$draft_exists" = "true" ] && printf true || printf false )" \
  --argjson draft_differs "$( [ "$draft_differs" = "true" ] && printf true || printf false )" \
  --slurpfile state "$state_tmp" \
  --slurpfile canonical_state "$canonical_state_tmp" \
  --slurpfile canonical_event "$canonical_event_tmp" \
  --slurpfile sync_status "$sync_status_tmp" \
  --slurpfile zap_config "$zap_config_tmp" \
  --slurpfile validation "$validation_tmp" \
  '{
    success: true,
    slug: $slug,
    page_type: $page_type,
    nav_title: $nav_title,
    kind: $kind,
    is_admin: $is_admin,
    view_mode: $view_mode,
    canonical_exists: $canonical_exists,
    draft_exists: $draft_exists,
    draft_differs: $draft_differs,
    sync_status: $sync_status[0],
    state: $state[0],
    canonical_state: $canonical_state[0],
    canonical_event: $canonical_event[0],
    zap_config: $zap_config[0],
    validation: {
      errors: ($validation[0].errors // []),
      warnings: ($validation[0].warnings // []),
      can_publish: ($validation[0].can_publish // true)
    }
  }' > "$response_tmp"
response_json=$(cat "$response_tmp")
response_signature=$(blog_nostr_prerender_signature "$response_json")
printf '%s\n' "$response_json" | jq -c --arg signature "$response_signature" '. + {prerender_signature: $signature}'
rm -f "$state_tmp" "$canonical_state_tmp" "$canonical_event_tmp" "$sync_status_tmp" "$zap_config_tmp" "$validation_tmp" "$response_tmp"
printf '\n'
