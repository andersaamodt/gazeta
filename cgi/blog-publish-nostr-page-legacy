#!/bin/sh
# Publish a Nostr-backed page draft.

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
. "$SCRIPT_DIR/blog-lib.sh"
. "$SCRIPT_DIR/blog-list-common.sh"
. "$SCRIPT_DIR/blog-public-ranking-common.sh"
. "$SCRIPT_DIR/blog-nostr-pages-common.sh"

blog_init
blog_read_request_body
blog_send_json_headers

if ! blog_require_session true true; then
  exit 0
fi
if ! blog_plugin_enabled "nostr_posts"; then
  blog_json_error "Nostr-backed pages plugin is disabled for this site" "plugin_disabled"
  exit 0
fi

page_slug_raw=$(blog_param page_slug)
if [ -z "$page_slug_raw" ]; then
  page_slug_raw=$(blog_param list_slug)
fi

blog_publish_nostr_page_json \
  "$page_slug_raw" \
  "$(blog_param preview_only)" \
  "$(blog_param event_json)"
