#!/bin/sh
# Private Desk API.

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
. "$SCRIPT_DIR/blog-lib.sh"
. "$SCRIPT_DIR/blog-desk-common.sh"

blog_init
blog_read_request_body
blog_send_json_headers

if ! blog_desk_require_owner; then
  exit 0
fi

BLOG_DESK_ROOT=$(blog_desk_root)
BLOG_DESK_STATE_DIR=$(blog_desk_state_dir)
BLOG_DESK_OWNER=$BLOG_SESSION_USERNAME
BLOG_DESK_OWNER_PUBKEY=$BLOG_SESSION_USER_PUBKEY
BLOG_DESK_ACTION=$(blog_param action)
BLOG_DESK_ROOM=$(blog_param room)
BLOG_DESK_DESTINATION_ROOM=$(blog_param destination_room)
BLOG_DESK_TARGET_ROOM=$(blog_param target_room)
BLOG_DESK_ROOM_TITLE=$(blog_param room_title)
BLOG_DESK_TASK_ID=$(blog_param task_id)
BLOG_DESK_TASK_TEXT=$(blog_param task_text)
BLOG_DESK_SOONNESS=$(blog_param soonness)
BLOG_DESK_QUERY=$(blog_param q)
BLOG_DESK_ONLINE_STATUS=$(blog_param online_status)
BLOG_DESK_VISIBILITY_THRESHOLD=$(blog_param visibility_threshold)
BLOG_DESK_METADATA_BACKEND=$(blog_param metadata_backend)
BLOG_DESK_OVERWORLD_BASE=$(config-get "$blog_site_conf" desk_overworld_url 2>/dev/null || printf '/overworld')

export BLOG_DESK_ROOT BLOG_DESK_STATE_DIR BLOG_DESK_OWNER BLOG_DESK_OWNER_PUBKEY
export BLOG_DESK_ACTION BLOG_DESK_ROOM BLOG_DESK_DESTINATION_ROOM BLOG_DESK_TARGET_ROOM
export BLOG_DESK_ROOM_TITLE BLOG_DESK_TASK_ID BLOG_DESK_TASK_TEXT BLOG_DESK_SOONNESS
export BLOG_DESK_QUERY BLOG_DESK_ONLINE_STATUS BLOG_DESK_VISIBILITY_THRESHOLD
export BLOG_DESK_METADATA_BACKEND BLOG_DESK_OVERWORLD_BASE

exec python3 "$SCRIPT_DIR/blog-desk.py"
