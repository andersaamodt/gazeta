#!/bin/sh
# Shared CGI adapter for Gazeta Theurgy Nostr read-runtime actions.

set -eu

action=${1-}
case "$action" in
  blog-comments|blog-post-context) ;;
  *)
    printf '%s\n\n' 'Content-Type: application/json'
    printf '{"success":false,"code":"bad_action","error":"Unknown Gazeta Nostr read action."}\n'
    exit 0
    ;;
esac

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd -P)

if [ -z "${WIZARDRY_SITES_DIR:-}" ] || [ -z "${WIZARDRY_SITE_NAME:-}" ]; then
  : "${WIZARDRY_SITES_DIR:=$(dirname "$REPO_ROOT")}"
  : "${WIZARDRY_SITE_NAME:=$(basename "$REPO_ROOT")}"
  export WIZARDRY_SITES_DIR WIZARDRY_SITE_NAME
fi
export GAZETA_REPO_ROOT=${GAZETA_REPO_ROOT:-$REPO_ROOT}

run_candidate() {
  candidate=$1
  [ -x "$candidate" ] || return 1
  exec "$candidate" "$action"
}

if [ -n "${GAZETA_NOSTR_READ_RUNTIME-}" ]; then
  run_candidate "$GAZETA_NOSTR_READ_RUNTIME" || {
    printf '%s\n\n' 'Content-Type: application/json'
    printf '{"success":false,"code":"runtime_missing","error":"Configured Gazeta Nostr read runtime is not executable."}\n'
    exit 0
  }
fi

if [ "${GAZETA_THEURGY_ALLOW_CARGO-}" = 1 ] && command -v cargo >/dev/null 2>&1; then
  exec cargo run --quiet --manifest-path "$REPO_ROOT/Cargo.toml" --bin gazeta-nostr-read -- "$action"
fi

run_candidate "$REPO_ROOT/target/release/gazeta-nostr-read" || true
run_candidate "$REPO_ROOT/target/debug/gazeta-nostr-read" || true

printf '%s\n\n' 'Content-Type: application/json'
printf '{"success":false,"code":"runtime_missing","error":"Gazeta Nostr read runtime is not built. Build target/release/gazeta-nostr-read or set GAZETA_NOSTR_READ_RUNTIME."}\n'
