#!/bin/sh
# Local maintenance entrypoint for Gazeta-derived indexes and caches.

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
if [ -z "${WIZARDRY_SITES_DIR:-}" ] || [ -z "${WIZARDRY_SITE_NAME:-}" ]; then
  script_site_root=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd -P)
  : "${WIZARDRY_SITES_DIR:=$(dirname "$script_site_root")}"
  : "${WIZARDRY_SITE_NAME:=$(basename "$script_site_root")}"
  export WIZARDRY_SITES_DIR WIZARDRY_SITE_NAME
fi

. "$SCRIPT_DIR/blog-lib.sh"
. "$SCRIPT_DIR/blog-nostr-pages-common.sh"

blog_init

action=${1:-rebuild-indexes}

case "$action" in
  rebuild-indexes | rebuild-caches | rebuild-public-posts)
    blog_public_posts_catalog_write_artifacts
    static_path=$(blog_public_posts_catalog_static_path)
    cache_path=$(blog_public_posts_catalog_cache_path)
    post_count=$(jq -r '(.posts // []) | length' "$static_path" 2>/dev/null || printf '0')
    jq -cn \
      --arg action "$action" \
      --arg static_path "$static_path" \
      --arg cache_path "$cache_path" \
      --argjson post_count "$post_count" \
      '{success:true,action:$action,rebuilt:["public-posts"],static_path:$static_path,cache_path:$cache_path,post_count:$post_count}'
    ;;
  rebuild-search-index)
    catalog_posts_tmp=$(mktemp "${TMPDIR:-/tmp}/blog-search-index-catalog-posts.XXXXXX")
    entries_tmp=$(mktemp "${TMPDIR:-/tmp}/blog-search-index-entries.XXXXXX")
    trap 'rm -f "$catalog_posts_tmp" "$entries_tmp"' EXIT HUP INT TERM
    blog_public_posts_catalog_build_json | jq -c '.posts[]?' > "$catalog_posts_tmp"
    while IFS= read -r row_json || [ -n "$row_json" ]; do
      [ -n "$row_json" ] || continue
      source_path=$(printf '%s\n' "$row_json" | jq -r '.source_path // ""' 2>/dev/null || printf '')
      [ -n "$source_path" ] || continue
      post_file=$(blog_managed_page_path_for_rel "$source_path" 2>/dev/null || printf '')
      [ -f "$post_file" ] || continue
      body=$(blog_read_markdown_body "$post_file" 2>/dev/null || printf '')
      printf '%s\n' "$row_json" | jq -c \
        --arg body "$body" '
          . + {
            search_text: [
              (.title // ""),
              ((.tags // []) | if type == "array" then join(",") else "" end),
              (.summary // ""),
              $body
            ] | join("\n")
          }
        ' >> "$entries_tmp"
    done < "$catalog_posts_tmp"
    index_json=$(jq -sc '{success:true,entries:.}' "$entries_tmp")
    static_path="$(blog_generated_static_dir)/search-index.json"
    cache_path="$blog_state_dir/search-index-cache.json"
    mkdir -p "$(dirname "$static_path")" "$(dirname "$cache_path")"
    static_tmp=$(mktemp "${TMPDIR:-/tmp}/blog-search-index-static.XXXXXX")
    cache_tmp=$(mktemp "${TMPDIR:-/tmp}/blog-search-index-cache.XXXXXX")
    printf '%s\n' "$index_json" > "$static_tmp"
    printf '%s\n' "$index_json" > "$cache_tmp"
    mv "$static_tmp" "$static_path"
    mv "$cache_tmp" "$cache_path"
    chmod 644 "$static_path" "$cache_path" 2>/dev/null || true
    entry_count=$(printf '%s\n' "$index_json" | jq -r '(.entries // []) | length' 2>/dev/null || printf '0')
    rm -f "$catalog_posts_tmp" "$entries_tmp"
    trap - EXIT HUP INT TERM
    jq -cn \
      --arg action "$action" \
      --arg static_path "$static_path" \
      --arg cache_path "$cache_path" \
      --argjson entry_count "$entry_count" \
      '{success:true,action:$action,rebuilt:["search-index"],static_path:$static_path,cache_path:$cache_path,entry_count:$entry_count}'
    ;;
  rebuild-navbar-pages)
    pages_json=$(blog_nostr_pages_load_json_fast)
    navbar_json=$(blog_nostr_navbar_pages_json "$pages_json")
    static_path="$(blog_generated_static_dir)/navbar-pages.json"
    cache_path="$blog_state_dir/navbar-pages-cache.json"
    mkdir -p "$(dirname "$static_path")" "$(dirname "$cache_path")"
    static_tmp=$(mktemp "${TMPDIR:-/tmp}/blog-navbar-static.XXXXXX")
    cache_tmp=$(mktemp "${TMPDIR:-/tmp}/blog-navbar-cache.XXXXXX")
    printf '%s\n' "$navbar_json" > "$static_tmp"
    printf '%s\n' "$navbar_json" > "$cache_tmp"
    mv "$static_tmp" "$static_path"
    mv "$cache_tmp" "$cache_path"
    chmod 644 "$static_path" "$cache_path" 2>/dev/null || true
    page_count=$(printf '%s\n' "$navbar_json" | jq -r '(.pages // []) | length' 2>/dev/null || printf '0')
    jq -cn \
      --arg action "$action" \
      --arg static_path "$static_path" \
      --arg cache_path "$cache_path" \
      --argjson page_count "$page_count" \
      '{success:true,action:$action,rebuilt:["navbar-pages"],static_path:$static_path,cache_path:$cache_path,page_count:$page_count}'
    ;;
  rebuild-product-index)
    . "$SCRIPT_DIR/blog-list-common.sh"
    . "$SCRIPT_DIR/blog-public-ranking-common.sh"
    . "$SCRIPT_DIR/blog-nostr-pages-common.sh"
    . "$SCRIPT_DIR/blog-payments-common.sh"
    blog_payments_init
    products_tmp=$(mktemp "${TMPDIR:-/tmp}/blog-product-index-products.XXXXXX")
    : > "$products_tmp"
    pages_json=$(blog_nostr_pages_load_json_fast)
    printf '%s\n' "$pages_json" | jq -r '.pages[]? | select((.type // "") == "nip23" or (.type // "") == "blog") | .slug // empty' 2>/dev/null |
      while IFS= read -r slug || [ -n "$slug" ]; do
        [ -n "$slug" ] || continue
        product_json=$(blog_payments_public_product_json "$slug" 2>/dev/null || printf '')
        [ -n "$product_json" ] || continue
        printf '%s\n' "$product_json" >> "$products_tmp"
      done
    index_json=$(jq -sc '{success:true,products:.}' "$products_tmp")
    static_path="$(blog_generated_static_dir)/product-index.json"
    cache_path="$blog_state_dir/product-index-cache.json"
    mkdir -p "$(dirname "$static_path")" "$(dirname "$cache_path")"
    static_tmp=$(mktemp "${TMPDIR:-/tmp}/blog-product-index-static.XXXXXX")
    cache_tmp=$(mktemp "${TMPDIR:-/tmp}/blog-product-index-cache.XXXXXX")
    printf '%s\n' "$index_json" > "$static_tmp"
    printf '%s\n' "$index_json" > "$cache_tmp"
    mv "$static_tmp" "$static_path"
    mv "$cache_tmp" "$cache_path"
    chmod 644 "$static_path" "$cache_path" 2>/dev/null || true
    product_count=$(printf '%s\n' "$index_json" | jq -r '(.products // []) | length' 2>/dev/null || printf '0')
    rm -f "$products_tmp"
    jq -cn \
      --arg action "$action" \
      --arg static_path "$static_path" \
      --arg cache_path "$cache_path" \
      --argjson product_count "$product_count" \
      '{success:true,action:$action,rebuilt:["product-index"],static_path:$static_path,cache_path:$cache_path,product_count:$product_count}'
    ;;
  *)
    jq -cn \
      --arg action "$action" \
      '{success:false,code:"bad_action",error:("Unknown Gazeta maintenance action: " + $action)}'
    ;;
esac
