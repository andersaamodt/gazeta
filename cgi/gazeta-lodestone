#!/bin/sh
# Resolve and run the Lodestone renderer for Gazeta build steps.

set -eu

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd -P)
component_command="$script_dir/gazeta-lodestone-components"

[ -x "$component_command" ] || {
  printf '%s\n' "gazeta-lodestone: missing component renderer: $component_command" >&2
  exit 1
}

lodestone_supports_component_command() {
  "$1" --help 2>&1 | grep -Fq -- '--component-command'
}

delegate_lodestone() {
  lodestone_cmd=$1
  shift
  action=${1-}
  case "$action" in
    verify-output)
      [ "$#" -ge 3 ] || exec "$lodestone_cmd" "$@"
      action=$1
      source_file=$2
      output_file=$3
      shift 3
      if lodestone_supports_component_command "$lodestone_cmd"; then
        exec "$lodestone_cmd" "$action" "$source_file" "$output_file" --component-command "$component_command" "$@"
      fi
      exec "$lodestone_cmd" "$action" "$source_file" "$output_file" "$@"
      ;;
    render|render-md|manifest|verify)
      [ "$#" -ge 2 ] || exec "$lodestone_cmd" "$@"
      action=$1
      source_file=$2
      shift 2
      if lodestone_supports_component_command "$lodestone_cmd"; then
        exec "$lodestone_cmd" "$action" "$source_file" --component-command "$component_command" "$@"
      fi
      exec "$lodestone_cmd" "$action" "$source_file" "$@"
      ;;
    *)
      exec "$lodestone_cmd" "$@"
      ;;
  esac
}

if [ -n "${GAZETA_LODESTONE:-}" ]; then
  delegate_lodestone "$GAZETA_LODESTONE" "$@"
fi

for candidate in \
  "$repo_root/../lodestone/spells/lodestone" \
  "$HOME/git/lodestone/spells/lodestone" \
  "/Users/andersaamodt/git/lodestone/spells/lodestone"
do
  if [ -x "$candidate" ]; then
    delegate_lodestone "$candidate" "$@"
  fi
done

printf '%s\n' "gazeta-lodestone: lodestone renderer is not available" >&2
exit 1
