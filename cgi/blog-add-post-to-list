#!/bin/sh
# Append a post-backed entry to a list draft.

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
. "$SCRIPT_DIR/blog-lib.sh"
. "$SCRIPT_DIR/blog-list-common.sh"
. "$SCRIPT_DIR/blog-nostr-pages-common.sh"

blog_init
blog_read_request_body
blog_send_json_headers

if ! blog_require_session true; then
  exit 0
fi

list_slug=$(blog_list_normalize_slug "$(blog_param list_slug)")
post_path=$(blog_param post_path)
entry_date=$(blog_param date)
entry_markdown=$(blog_param markdown)
marker=$(blog_param marker)
relay_hint=$(blog_param relay_hint)

if [ -z "$list_slug" ] || [ -z "$post_path" ]; then
  blog_json_error "list_slug and post_path are required" "missing_params"
  exit 0
fi
if [ -z "$marker" ]; then
  marker="list"
fi

post_path=$(printf '%s' "$post_path" | sed -e 's#^https\{0,1\}://[^/]*/##' -e 's#^/##' -e 's#^pages/##')
case "$post_path" in
  *'..'*|*'\\'*|*'//'*)
    blog_json_error "Invalid post path" "invalid_post_path"
    exit 0
    ;;
esac

file=$(blog_resolve_post_markdown_file "$post_path" 2>/dev/null || printf '')
if [ -z "$file" ] || [ ! -f "$file" ]; then
  blog_json_error "Post not found" "not_found"
  exit 0
fi
post_path=$(blog_managed_post_rel_path_for_file "$file" 2>/dev/null || printf '')
if [ -z "$post_path" ]; then
  blog_json_error "Invalid post path" "invalid_post_path"
  exit 0
fi

post_url=$(blog_rel_post_html_url "$file")
if [ -z "$entry_markdown" ]; then
  entry_markdown=$(blog_read_front_matter_value "$file" title 2>/dev/null || printf '')
fi

page_type=$(blog_nostr_page_type_for_slug "$list_slug" 2>/dev/null || printf 'list')
if [ "$page_type" = "publication" ]; then
  post_address=$(blog_post_nostr_address_for_file "$file" 2>/dev/null || printf '')
  case "$post_address" in
    30023:[0-9a-f][0-9a-f]*) ;;
    *)
      blog_json_error "Publish this post to Nostr as kind 30023 before adding it to a publication" "post_not_nostr_addressable"
      exit 0
      ;;
  esac
  state_json=$(blog_nostr_page_load_draft_state_json "$list_slug" publication 2>/dev/null || printf '')
  if [ -z "$state_json" ]; then
    canonical_event=$(blog_nostr_publication_latest_event_json "$list_slug" 2>/dev/null || printf '')
    if [ -n "$canonical_event" ]; then
      state_json=$(blog_publication_state_from_event_json "$list_slug" "$canonical_event")
    else
      state_json=$(blog_publication_seed_state_if_empty "$list_slug" "$(blog_publication_default_state_json "$list_slug")")
    fi
  fi
  next_state=$(blog_publication_normalize_state_json "$list_slug" "$state_json" | jq -c --arg address "$post_address" '.member_addresses |= (if index($address) == null then . + [$address] else . end)')
  blog_nostr_page_save_draft_state_json "$list_slug" publication "$next_state"
  validation_json=$(blog_publication_validate_state_json "$next_state" false)
  jq -cn --arg list_slug "$list_slug" --argjson state "$next_state" --argjson validation "$validation_json" '{success:true,list_slug:$list_slug,state:$state,validation:$validation,message:"Post added to publication draft."}'
  printf '\n'
  exit 0
fi
case "$page_type" in
  list|icon-gallery|software-gallery) ;;
  *) page_type='list' ;;
esac

state_json=$(blog_nostr_page_load_draft_state_json "$list_slug" "$page_type" 2>/dev/null || printf '')
if [ -z "$state_json" ]; then
  state_json=$(blog_list_load_canonical_state_json "$list_slug")
fi
state_json=$(blog_list_normalize_state_json "$list_slug" "$state_json")

next_state=$(printf '%s\n' "$state_json" | jq -c \
  --arg event_id "" \
  --arg relay_hint "" \
  --arg marker "$marker" \
  --arg date "$entry_date" \
  --arg markdown "$entry_markdown" \
  --arg post_url "$post_url" '
  .elements = ((.elements // []) + [{
    type: "entry",
    event_id: $event_id,
    relay_hint: $relay_hint,
    marker: $marker,
    date: $date,
    markdown: $markdown,
    post_url: $post_url
  }])
  | .entries = (.elements // [])
')
next_state=$(blog_list_normalize_state_json "$list_slug" "$next_state")
blog_nostr_page_save_draft_state_json "$list_slug" "$page_type" "$next_state"
validation_json=$(blog_list_validate_and_enrich_state_json "$next_state" false)

jq -cn \
  --arg list_slug "$list_slug" \
  --argjson state "$next_state" \
  --argjson validation "$validation_json" \
  '{
    success: true,
    list_slug: $list_slug,
    state: ($state + {elements: $validation.elements, entries: $validation.entries}),
    validation: {
      errors: $validation.errors,
      warnings: $validation.warnings,
      can_publish: $validation.can_publish
    },
    message: "Entry added to list draft."
  }'
printf '\n'
