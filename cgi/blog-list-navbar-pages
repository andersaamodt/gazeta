#!/bin/sh
# Public navbar page list through the Gazeta Theurgy read runtime.

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd -P)

if [ -z "${WIZARDRY_SITES_DIR:-}" ] || [ -z "${WIZARDRY_SITE_NAME:-}" ]; then
  : "${WIZARDRY_SITES_DIR:=$(dirname "$REPO_ROOT")}"
  : "${WIZARDRY_SITE_NAME:=$(basename "$REPO_ROOT")}"
  export WIZARDRY_SITES_DIR WIZARDRY_SITE_NAME
fi
export GAZETA_REPO_ROOT=${GAZETA_REPO_ROOT:-$REPO_ROOT}

run_candidate() {
  candidate=$1
  [ -x "$candidate" ] || return 1
  exec "$candidate" list-navbar-pages
}

if [ -n "${GAZETA_READ_RUNTIME-}" ]; then
  run_candidate "$GAZETA_READ_RUNTIME" || {
    printf '%s\n\n' 'Content-Type: application/json'
    printf '{"success":false,"code":"runtime_missing","error":"Configured Gazeta read runtime is not executable."}\n'
    exit 0
  }
fi

if [ "${GAZETA_THEURGY_ALLOW_CARGO-}" = 1 ] && command -v cargo >/dev/null 2>&1; then
  exec cargo run --quiet --manifest-path "$REPO_ROOT/Cargo.toml" --bin gazeta-read -- list-navbar-pages
fi

run_candidate "$REPO_ROOT/target/release/gazeta-read" || true
run_candidate "$REPO_ROOT/target/debug/gazeta-read" || true

printf '%s\n\n' 'Content-Type: application/json'
printf '{"success":false,"code":"runtime_missing","error":"Gazeta read runtime is not built. Build target/release/gazeta-read or set GAZETA_READ_RUNTIME."}\n'
