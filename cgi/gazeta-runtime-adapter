#!/bin/sh
# Shared CGI adapter for Gazeta Theurgy runtimes.

set -eu

domain=${1-}
action=${2-}

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd -P)
REGISTRY_FILE="$SCRIPT_DIR/gazeta-action-registry.conf"

runtime_bin=''
runtime_env=''
unknown_action=''
configured_missing=''
runtime_missing=''

case "$domain" in
  read)
    runtime_bin='gazeta-read'
    runtime_env='GAZETA_READ_RUNTIME'
    unknown_action='Unknown Gazeta read action.'
    configured_missing='Configured Gazeta read runtime is not executable.'
    runtime_missing='Gazeta read runtime is not built. Build ~/.local/state/gazeta/cargo-target/release/gazeta-read or set GAZETA_READ_RUNTIME.'
    ;;
  admin-read)
    runtime_bin='gazeta-admin-read'
    runtime_env='GAZETA_ADMIN_READ_RUNTIME'
    unknown_action='Unknown Gazeta admin read action.'
    configured_missing='Configured Gazeta admin read runtime is not executable.'
    runtime_missing='Gazeta admin read runtime is not built. Build ~/.local/state/gazeta/cargo-target/release/gazeta-admin-read or set GAZETA_ADMIN_READ_RUNTIME.'
    ;;
  commerce-read)
    runtime_bin='gazeta-commerce-read'
    runtime_env='GAZETA_COMMERCE_READ_RUNTIME'
    unknown_action='Unknown Gazeta commerce read action.'
    configured_missing='Configured Gazeta commerce read runtime is not executable.'
    runtime_missing='Gazeta commerce read runtime is not built. Build ~/.local/state/gazeta/cargo-target/release/gazeta-commerce-read or set GAZETA_COMMERCE_READ_RUNTIME.'
    ;;
  nostr-read)
    runtime_bin='gazeta-nostr-read'
    runtime_env='GAZETA_NOSTR_READ_RUNTIME'
    unknown_action='Unknown Gazeta Nostr read action.'
    configured_missing='Configured Gazeta Nostr read runtime is not executable.'
    runtime_missing='Gazeta Nostr read runtime is not built. Build ~/.local/state/gazeta/cargo-target/release/gazeta-nostr-read or set GAZETA_NOSTR_READ_RUNTIME.'
    ;;
  admin)
    runtime_bin='gazeta-admin'
    runtime_env='GAZETA_ADMIN_RUNTIME'
    unknown_action='Unknown Gazeta admin action.'
    configured_missing='Configured Gazeta admin runtime is not executable.'
    runtime_missing='Gazeta admin runtime is not built. Build ~/.local/state/gazeta/cargo-target/release/gazeta-admin or set GAZETA_ADMIN_RUNTIME.'
    ;;
  *)
    printf '%s\n\n' 'Content-Type: application/json'
    printf '{"success":false,"code":"bad_domain","error":"Unknown Gazeta runtime domain."}\n'
    exit 0
    ;;
esac

action_allowed=false
if [ -n "$action" ] && [ -f "$REGISTRY_FILE" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ''|'#'*) continue ;;
    esac
    set -- $line
    if [ "$#" -eq 2 ] && [ "$1" = "$domain" ] && [ "$2" = "$action" ]; then
      action_allowed=true
      break
    fi
  done < "$REGISTRY_FILE"
fi

if [ "$action_allowed" != 'true' ]; then
  printf '%s\n\n' 'Content-Type: application/json'
  printf '{"success":false,"code":"bad_action","error":"%s"}\n' "$unknown_action"
  exit 0
fi

# shellcheck disable=SC1091
. "$SCRIPT_DIR/gazeta-paths.sh"
RELEASE_RUNTIME=$(gazeta_runtime_path release "$runtime_bin")
DEBUG_RUNTIME=$(gazeta_runtime_path debug "$runtime_bin")

if [ -z "${WIZARDRY_SITES_DIR:-}" ] || [ -z "${WIZARDRY_SITE_NAME:-}" ]; then
  : "${WIZARDRY_SITES_DIR:=$(dirname "$REPO_ROOT")}"
  : "${WIZARDRY_SITE_NAME:=$(basename "$REPO_ROOT")}"
  export WIZARDRY_SITES_DIR WIZARDRY_SITE_NAME
fi
export GAZETA_REPO_ROOT=${GAZETA_REPO_ROOT:-$REPO_ROOT}

run_candidate() {
  candidate=$1
  [ -x "$candidate" ] || return 1
  exec "$candidate" "$action"
}

eval "configured_runtime=\${$runtime_env-}"
if [ -n "$configured_runtime" ]; then
  run_candidate "$configured_runtime" || {
    printf '%s\n\n' 'Content-Type: application/json'
    printf '{"success":false,"code":"runtime_missing","error":"%s"}\n' "$configured_missing"
    exit 0
  }
fi

if [ "${GAZETA_THEURGY_ALLOW_CARGO-}" = 1 ] && command -v cargo >/dev/null 2>&1; then
  exec "$SCRIPT_DIR/gazeta-cargo" run --quiet --manifest-path "$REPO_ROOT/Cargo.toml" --bin "$runtime_bin" -- "$action"
fi

run_candidate "$RELEASE_RUNTIME" || true
run_candidate "$DEBUG_RUNTIME" || true

printf '%s\n\n' 'Content-Type: application/json'
printf '{"success":false,"code":"runtime_missing","error":"%s"}\n' "$runtime_missing"
