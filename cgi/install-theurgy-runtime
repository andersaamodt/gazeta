#!/bin/sh
# Build Gazeta Theurgy runtime binaries for CGI adapters.

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd -P)
# shellcheck disable=SC1091
. "$SCRIPT_DIR/gazeta-paths.sh"

cd "$REPO_ROOT"
CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS:-1}
export CARGO_BUILD_JOBS
"$SCRIPT_DIR/gazeta-cargo" build --release \
  --bin gazeta-admin \
  --bin gazeta-admin-read \
  --bin gazeta-read \
  --bin gazeta-nostr-read \
  --bin gazeta-commerce-read

printf '%s\n' "$(gazeta_runtime_path release gazeta-admin)"
printf '%s\n' "$(gazeta_runtime_path release gazeta-admin-read)"
printf '%s\n' "$(gazeta_runtime_path release gazeta-read)"
printf '%s\n' "$(gazeta_runtime_path release gazeta-nostr-read)"
printf '%s\n' "$(gazeta_runtime_path release gazeta-commerce-read)"
