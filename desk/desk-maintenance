#!/bin/sh
# Local maintenance command for Desk.

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd -P)
CGI_DIR="$REPO_ROOT/cgi"

if [ -z "${WIZARDRY_SITES_DIR:-}" ]; then
  WIZARDRY_SITES_DIR="$HOME/sites"
fi
if [ -z "${WIZARDRY_SITE_NAME:-}" ]; then
  WIZARDRY_SITE_NAME="andersaamodt.com"
fi
export WIZARDRY_SITES_DIR WIZARDRY_SITE_NAME

. "$CGI_DIR/blog-lib.sh"
. "$CGI_DIR/blog-desk-common.sh"

blog_init

action=${1:-audit}
backend=${2:-sidecar}

case "$action" in
  audit|rebuild-indexes|list-orphans|migrate-metadata) ;;
  rebuild) action=rebuild-indexes ;;
  orphaned) action=list-orphans ;;
  *)
    printf '%s\n' "Usage: desk/desk-maintenance [audit|rebuild-indexes|list-orphans|migrate-metadata] [sidecar|xattr]" >&2
    exit 2
    ;;
esac

BLOG_DESK_ROOT=$(blog_desk_root)
BLOG_DESK_STATE_DIR=$(blog_desk_state_dir)
BLOG_DESK_OWNER=${USER:-local}
BLOG_DESK_OWNER_PUBKEY=local-maintenance
BLOG_DESK_ACTION=$action
BLOG_DESK_METADATA_BACKEND=$backend
BLOG_DESK_OVERWORLD_BASE=$(config-get "$blog_site_conf" desk_overworld_url 2>/dev/null || printf '/overworld')
export BLOG_DESK_ROOT BLOG_DESK_STATE_DIR BLOG_DESK_OWNER BLOG_DESK_OWNER_PUBKEY
export BLOG_DESK_ACTION BLOG_DESK_METADATA_BACKEND BLOG_DESK_OVERWORLD_BASE

exec python3 "$CGI_DIR/blog-desk.py"
